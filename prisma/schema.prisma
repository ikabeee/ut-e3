// Data model (odd/design/er-model.html). The ER `sql` rules (CHECKs, partial indexes and triggers) are
// hand-written in the migrations, because Prisma does not declare them.

// moduleFormat cjs: Jest runs CommonJS, and the ESM client imports the query compiler as .mjs, which Jest cannot load.
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model EventSettings {
  id                      Int       @id @default(1)
  eventStartsAt           DateTime  @map("event_starts_at")
  eventEndsAt             DateTime  @map("event_ends_at")
  registrationOpensAt     DateTime  @map("registration_opens_at")
  kofRegistrationOpensAt  DateTime  @map("kof_registration_opens_at")
  kofCheckInStartsAt      DateTime  @map("kof_check_in_starts_at")
  kofCheckInEndsAt        DateTime  @map("kof_check_in_ends_at")
  kofOnsiteSignupStartsAt DateTime  @map("kof_onsite_signup_starts_at")
  kofOnsiteSignupEndsAt   DateTime  @map("kof_onsite_signup_ends_at")
  kofBracketGeneratesAt   DateTime  @map("kof_bracket_generates_at")
  marketplaceClosesAt     DateTime  @map("marketplace_closes_at")
  marketplaceFormUrl      String?   @map("marketplace_form_url")
  itchOpensAt             DateTime  @map("itch_opens_at")
  checkInCutoffAt         DateTime  @map("check_in_cutoff_at")
  raffleStartsAt          DateTime  @map("raffle_starts_at")
  raffleClosedAt          DateTime? @map("raffle_closed_at")
  bracketGeneratedAt      DateTime? @map("bracket_generated_at")
  publicBracketEnabled    Boolean   @map("public_bracket_enabled")
  fraudTopScoreCount      Int       @default(12) @map("fraud_top_score_count")
  fraudWindowMinutes      Int       @default(10) @map("fraud_window_minutes")
  fraudSingleVisitMax     Int       @default(1) @map("fraud_single_visit_max")

  @@map("event_settings")
}

model Account {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String
  role              String
  group             String?
  studio            Int?
  /// scrypt hash with its parameters and salt (shared/lib/server/password.ts); null until the account is activated.
  password          String?           @map("password_scrypt")
  status            String
  standId           String?           @map("stand_id")
  stand             Stand?            @relation(fields: [standId], references: [id], onDelete: Restrict)
  kofDesk           Int?              @map("kof_desk")
  createdById       String?           @map("created_by_id")
  createdBy         Account?          @relation("CreatedAccounts", fields: [createdById], references: [id], onDelete: Restrict)
  created           Account[]         @relation("CreatedAccounts")
  sessions          Session[]
  auditLogs         AuditLog[]
  registeredEntries TournamentEntry[]

  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie token (shared/lib/server/session.ts); the token itself only lives in the cookie.
  token     String   @unique @map("token_sha256")
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      Account? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  detail     Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model KofTournament {
  id        Int      @id
  /// The whole bracket as JSON (features/tournament/lib/types.ts); only the server writes it.
  state     Json
  /// Raised by every command; a save succeeds only if the stored version is still the one that was read.
  version   Int
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kof_tournament")
}

model RateLimit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int

  @@id([key, windowStart])
  @@map("rate_limits")
}

model ScheduleItem {
  id          String   @id @default(uuid())
  title       String
  description String
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  zone        String?

  @@map("schedule_items")
}

model Stand {
  id        String    @id @default(uuid())
  zone      String
  number    Int
  studio    Int
  groupCode String    @map("group_code")
  game      Game?
  accounts  Account[]

  @@unique([zone, number])
  @@map("stands")
}

model Genre {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  games Game[]

  @@map("genres")
}

model Game {
  id       String      @id @default(uuid())
  standId  String      @unique @map("stand_id")
  stand    Stand       @relation(fields: [standId], references: [id])
  name     String
  slug     String      @unique
  synopsis String
  genreId  String      @map("genre_id")
  genre    Genre       @relation(fields: [genreId], references: [id], onDelete: Restrict)
  itchUrl  String?     @map("itch_url")
  images   GameImage[]

  @@map("games")
}

model GameImage {
  id       String  @id @default(uuid())
  gameId   String  @map("game_id")
  game     Game    @relation(fields: [gameId], references: [id])
  path     String
  alt      String
  position Int
  isCover  Boolean @map("is_cover")

  @@unique([gameId, position])
  @@map("game_images")
}

model Sponsor {
  id         String @id @default(uuid())
  name       String
  logoPath   String @map("logo_path")
  websiteUrl String @map("website_url")
  phone      String
  services   String
  position   Int

  @@map("sponsors")
}

model Visitor {
  id              String           @id @default(uuid())
  fullName        String           @map("full_name")
  gamertag        String           @unique
  email           String           @unique
  pin             String           @map("pin_aes_gcm")
  pinLookup       String           @unique @map("pin_hmac")
  createdAt       DateTime         @default(now()) @map("created_at")
  device          VisitorDevice?
  tournamentEntry TournamentEntry?

  @@map("visitors")
}

model VisitorDevice {
  id        String   @id @default(uuid())
  visitorId String   @unique @map("visitor_id")
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  /// SHA-256 of the device token cookie; the token itself only lives in the cookie.
  token     String   @unique @map("token_sha256")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("visitor_devices")
}

model EmailBlocklist {
  email     String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_blocklist")
}

model EmailOutbox {
  id            String    @id @default(uuid())
  to            String    @map("to_address")
  subject       String
  text          String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  sentAt        DateTime? @map("sent_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("email_outbox")
}

model TournamentEntry {
  id             String    @id @default(uuid())
  visitorId      String    @unique @map("visitor_id")
  visitor        Visitor   @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  /// pre: the list that the KOF administrator builds before the event; onsite: the sign-up at the KOF area.
  channel        String
  /// registered, checked_in or no_show; a no_show never changes again (trigger in the migration).
  status         String
  checkedInAt    DateTime? @map("checked_in_at")
  registeredById String?   @map("registered_by_id")
  registeredBy   Account?  @relation(fields: [registeredById], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("tournament_entries")
}
