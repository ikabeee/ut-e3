// Data model (odd/design/er-model.html). The ER `sql` rules (CHECKs, partial indexes and triggers) are
// hand-written in the migrations, because Prisma does not declare them.

// moduleFormat cjs: Jest runs CommonJS, and the ESM client imports the query compiler as .mjs, which Jest cannot load.
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model EventSettings {
  id                      Int       @id @default(1)
  eventStartsAt           DateTime  @map("event_starts_at")
  eventEndsAt             DateTime  @map("event_ends_at")
  registrationOpensAt     DateTime  @map("registration_opens_at")
  kofRegistrationOpensAt  DateTime  @map("kof_registration_opens_at")
  kofCheckInStartsAt      DateTime  @map("kof_check_in_starts_at")
  kofCheckInEndsAt        DateTime  @map("kof_check_in_ends_at")
  kofOnsiteSignupStartsAt DateTime  @map("kof_onsite_signup_starts_at")
  kofOnsiteSignupEndsAt   DateTime  @map("kof_onsite_signup_ends_at")
  kofBracketGeneratesAt   DateTime  @map("kof_bracket_generates_at")
  marketplaceClosesAt     DateTime  @map("marketplace_closes_at")
  marketplaceFormUrl      String?   @map("marketplace_form_url")
  itchOpensAt             DateTime  @map("itch_opens_at")
  checkInCutoffAt         DateTime  @map("check_in_cutoff_at")
  raffleStartsAt          DateTime  @map("raffle_starts_at")
  raffleClosedAt          DateTime? @map("raffle_closed_at")
  bracketGeneratedAt      DateTime? @map("bracket_generated_at")
  publicBracketEnabled    Boolean   @map("public_bracket_enabled")
  fraudTopScoreCount      Int       @default(12) @map("fraud_top_score_count")
  fraudWindowMinutes      Int       @default(10) @map("fraud_window_minutes")
  fraudSingleVisitMax     Int       @default(1) @map("fraud_single_visit_max")
  /// Salt of the PIN filter of the kiosk (RNF-19). Fixed by the seed, so the e2e can compute a false positive.
  pinFilterSalt           String    @default("ut-e3-pixel-and-code-2026") @map("pin_filter_salt")

  @@map("event_settings")
}

model Account {
  id                String              @id @default(uuid())
  email             String              @unique
  name              String
  role              String
  group             String?
  studio            Int?
  /// scrypt hash with its parameters and salt (shared/lib/server/password.ts); null until the account is activated.
  password          String?             @map("password_scrypt")
  status            String
  standId           String?             @map("stand_id")
  stand             Stand?              @relation(fields: [standId], references: [id], onDelete: Restrict)
  kofDesk           Int?                @map("kof_desk")
  createdById       String?             @map("created_by_id")
  createdBy         Account?            @relation("CreatedAccounts", fields: [createdById], references: [id], onDelete: Restrict)
  created           Account[]           @relation("CreatedAccounts")
  sessions          Session[]
  auditLogs         AuditLog[]
  registeredEntries TournamentEntry[]
  invitations       AccountInvitation[]
  recoveryTokens    RecoveryToken[]
  scannedCheckIns   CheckIn[]           @relation("ScannedCheckIns")
  annulledCheckIns  CheckIn[]           @relation("AnnulledCheckIns")
  requestedVisits   PendingVisit[]
  raffleDraws       RaffleDraw[]        @relation("RaffleDraws")
  rafflePrizes      RaffleDraw[]        @relation("RafflePrizes")

  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie token (shared/lib/server/session.ts); the token itself only lives in the cookie.
  token     String   @unique @map("token_sha256")
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      Account? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  detail     Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model KofTournament {
  id        Int      @id
  /// The whole bracket as JSON (features/tournament/lib/types.ts); only the server writes it.
  state     Json
  /// Raised by every command; a save succeeds only if the stored version is still the one that was read.
  version   Int
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kof_tournament")
}

model RateLimit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int

  @@id([key, windowStart])
  @@map("rate_limits")
}

model ScheduleItem {
  id          String   @id @default(uuid())
  title       String
  description String
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  zone        String?

  @@map("schedule_items")
}

model Stand {
  id        String         @id @default(uuid())
  zone      String
  number    Int
  studio    Int
  groupCode String         @map("group_code")
  game      Game?
  accounts  Account[]
  checkIns  CheckIn[]
  votes     Vote[]
  pending   PendingVisit[]
  rejected  RejectedVisit[]

  @@unique([zone, number])
  @@map("stands")
}

model Genre {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  games Game[]

  @@map("genres")
}

model Game {
  id       String      @id @default(uuid())
  standId  String      @unique @map("stand_id")
  stand    Stand       @relation(fields: [standId], references: [id])
  name     String
  slug     String      @unique
  synopsis String
  genreId  String      @map("genre_id")
  genre    Genre       @relation(fields: [genreId], references: [id], onDelete: Restrict)
  itchUrl  String?     @map("itch_url")
  images   GameImage[]

  @@map("games")
}

model GameImage {
  id       String  @id @default(uuid())
  gameId   String  @map("game_id")
  game     Game    @relation(fields: [gameId], references: [id])
  path     String
  alt      String
  position Int
  isCover  Boolean @map("is_cover")

  @@unique([gameId, position])
  @@map("game_images")
}

model Sponsor {
  id         String @id @default(uuid())
  name       String
  logoPath   String @map("logo_path")
  websiteUrl String @map("website_url")
  phone      String
  services   String
  position   Int

  @@map("sponsors")
}

model Visitor {
  id              String           @id @default(uuid())
  fullName        String           @map("full_name")
  gamertag        String           @unique
  email           String           @unique
  pin             String           @map("pin_aes_gcm")
  pinLookup       String           @unique @map("pin_hmac")
  createdAt       DateTime         @default(now()) @map("created_at")
  /// Set by the sysadmin with a reason (RF-46): the passport stays, but its visits stop counting and its tickets
  /// stay out of the raffle. Both columns go together (CHECK in the migration).
  excludedAt      DateTime?        @map("excluded_at")
  excludedReason  String?          @map("excluded_reason")
  device          VisitorDevice?
  checkIns        CheckIn[]
  raffleTickets   RaffleTicket[]
  tournamentEntry TournamentEntry?
  votes           Vote[]
  pendingVisit    PendingVisit?
  rejectedVisits  RejectedVisit[]
  recoveryTokens  RecoveryToken[]

  @@map("visitors")
}

model VisitorDevice {
  id        String   @id @default(uuid())
  visitorId String   @unique @map("visitor_id")
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  /// SHA-256 of the device token cookie; the token itself only lives in the cookie.
  token     String   @unique @map("token_sha256")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("visitor_devices")
}

/// One-use recovery link (RF-68): the SQL of the migration checks the channel and that help_desk names its agent.
model RecoveryToken {
  id         String    @id @default(uuid())
  visitorId  String    @map("visitor_id")
  visitor    Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token in the link; the token itself only travels in the email.
  token      String    @unique @map("token_sha256")
  channel    String
  issuedById String?   @map("issued_by_id")
  issuedBy   Account?  @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([visitorId])
  @@map("recovery_tokens")
}

model EmailBlocklist {
  email     String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_blocklist")
}

model EmailOutbox {
  id            String    @id @default(uuid())
  to            String    @map("to_address")
  subject       String
  text          String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  sentAt        DateTime? @map("sent_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("email_outbox")
}

model TournamentEntry {
  id             String    @id @default(uuid())
  visitorId      String    @unique @map("visitor_id")
  visitor        Visitor   @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  /// pre: the list that the KOF administrator builds before the event; onsite: the sign-up at the KOF area.
  channel        String
  /// registered, checked_in or no_show; a no_show never changes again (trigger in the migration).
  status         String
  checkedInAt    DateTime? @map("checked_in_at")
  registeredById String?   @map("registered_by_id")
  registeredBy   Account?  @relation(fields: [registeredById], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("tournament_entries")
}

model AccountInvitation {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token in the activation link (shared/lib/server/token-hash.ts); the token itself only travels by email.
  token     String    @unique @map("token_sha256")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("account_invitations")
}

model CheckIn {
  id             String    @id @default(uuid())
  visitorId      String    @map("visitor_id")
  visitor        Visitor   @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  standId        String    @map("stand_id")
  stand          Stand     @relation(fields: [standId], references: [id], onDelete: Restrict)
  checkedInAt    DateTime  @default(now()) @map("checked_in_at")
  /// When the kiosk took the PIN: a visit of the offline queue reaches the server later (RN-04, RF-35).
  scannedAt      DateTime? @map("scanned_at")
  /// The staff account that had the kiosk open when the visit was recorded (RF-36).
  scannedById    String?   @map("scanned_by_id")
  scannedBy      Account?  @relation("ScannedCheckIns", fields: [scannedById], references: [id], onDelete: Restrict)
  /// An annulled check-in (RF-46) is kept: it stops counting in visits, tickets, averages and alerts. The three
  /// columns go together (CHECK in the migration).
  annulledAt     DateTime? @map("annulled_at")
  annulledReason String?   @map("annulled_reason")
  annulledById   String?   @map("annulled_by_id")
  annulledBy     Account?  @relation("AnnulledCheckIns", fields: [annulledById], references: [id], onDelete: Restrict)
  vote           Vote?

  @@unique([visitorId, standId])
  @@map("checkins")
}

/// The satisfaction survey of a visit (RF-26): one per visitor and stand, created together with its check-in (RF-28).
model Vote {
  id          String   @id @default(uuid())
  checkInId   String   @unique @map("check_in_id")
  checkIn     CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Restrict)
  visitorId   String   @map("visitor_id")
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  standId     String   @map("stand_id")
  stand       Stand    @relation(fields: [standId], references: [id], onDelete: Restrict)
  gameRating  Int      @map("game_rating")
  standRating Int      @map("stand_rating")
  artRating   Int      @map("art_rating")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([visitorId, standId])
  @@map("votes")
}

model RaffleTicket {
  /// Global autoincremental ticket number (RF-22). SQLite only autoincrements the primary key, so it is the id.
  number    Int      @id @default(autoincrement())
  visitorId String   @map("visitor_id")
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  milestone Int
  /// active: enters the raffle; drawn: its visitor was drawn, so none of the visitor's tickets enter again (RF-52,
  /// RN-05); voided: annulled with its check-in (RF-46).
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  draw      RaffleDraw?

  @@unique([visitorId, milestone])
  @@map("raffle_tickets")
}

/// A visit the staff started with the PIN and the visitor has not rated yet. The visitor answers it from the passport,
/// which records the visit; it expires on its own. A visitor has at most one at a time.
model PendingVisit {
  id            String    @id @default(uuid())
  visitorId     String    @unique @map("visitor_id")
  visitor       Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  standId       String    @map("stand_id")
  stand         Stand     @relation(fields: [standId], references: [id], onDelete: Cascade)
  /// The staff account that had the kiosk open; it becomes `scannedById` of the check-in (RF-36).
  requestedById String    @map("requested_by_id")
  requestedBy   Account   @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  expiresAt     DateTime  @map("expires_at")
  answeredAt    DateTime? @map("answered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("pending_visits")
}

/// One spin of the raffle drum (RF-49 to RF-55). The partial unique index of the migration allows a single `pending`
/// draw, so nobody can spin again until the drawn ticket is decided (RF-51).
model RaffleDraw {
  id           String       @id @default(uuid())
  /// A ticket comes out once at most.
  ticketNumber Int          @unique @map("ticket_number")
  ticket       RaffleTicket @relation(fields: [ticketNumber], references: [number], onDelete: Restrict)
  /// Generated by the panel for each press of "Girar", so a repeated request returns the same draw (RNF-05, EC-08).
  requestId    String       @unique @map("request_id")
  drawnById    String       @map("drawn_by_id")
  drawnBy      Account      @relation("RaffleDraws", fields: [drawnById], references: [id], onDelete: Restrict)
  /// pending, winner or discarded; once decided it never changes (trigger in the migration).
  outcome      String       @default("pending")
  drawnAt      DateTime     @default(now()) @map("drawn_at")
  decidedAt    DateTime?    @map("decided_at")
  /// The prize handed to a winner (RF-55); only a `winner` has one and it is written once.
  prizeName    String?      @map("prize_name")
  prizeById    String?      @map("prize_by_id")
  prizeBy      Account?     @relation("RafflePrizes", fields: [prizeById], references: [id], onDelete: Restrict)

  @@map("raffle_draws")
/// A visit of the offline queue of a kiosk that the server refused for a known visitor, so the passport can say it
/// (RF-24). A PIN that is nobody's identifies no one: it only stays in the list of the kiosk (RF-35).
model RejectedVisit {
  /// The id the kiosk gave to the queued visit: a batch sent twice records the refusal once.
  id        String   @id
  visitorId String   @map("visitor_id")
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  standId   String   @map("stand_id")
  stand     Stand    @relation(fields: [standId], references: [id], onDelete: Cascade)
  reason    String
  scannedAt DateTime @map("scanned_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([visitorId])
  @@map("rejected_visits")
}
