// use prisma-8

// Contrato de datos del proyecto. El modelo y sus reglas están en docs/data-model.md.
// Después de editarlo ejecuta `npm run db:emit` y sube a git contract.json y contract.d.ts.
//
// Convenciones:
// - Tablas en singular (@@map) y columnas en snake_case (@map).
// - Los textos son `String` (text) con un CHECK de longitud: equivale a varchar(n) en
//   PostgreSQL y el ORM los recibe como string normal.
// - Las relaciones inversas (members, images...) se declaran para poder usar `.include()`.

enum StudentGroup {
  @@type("pg/text@1")
  IDYGS101 = "IDYGS101"
  IDYGS102 = "IDYGS102"
  IDYGS103 = "IDYGS103"
}

// ---------------------------------------------------------------------------
// Catálogo: equipos y juegos
// ---------------------------------------------------------------------------

model Team {
  id             Uuid                       @id @default(uuid())
  name           String                     @unique
  /// Código del stand (A1-A9, B1-B9). Vacío hasta que se asigna.
  standCode      String?                    @unique @map("stand_code")
  /// SHA-256 (hex) de la llave del escáner del stand.
  scannerKeyHash String                     @unique @map("scanner_key_hash")
  createdAt      temporal.createdAtString() @map("created_at")
  updatedAt      temporal.updatedAtString() @map("updated_at")
  members        TeamMember[]
  game           Game?

  @@check(expression: "char_length(name) <= 80", name: "team_name_length")
  @@check(expression: "stand_code ~ '^[AB][1-9]$'", name: "team_stand_code_format")
  @@check(expression: "scanner_key_hash ~ '^[0-9a-f]{64}$'", name: "team_scanner_key_hash_hex")
  @@map("team")
}

model TeamMember {
  id        Uuid                       @id @default(uuid())
  teamId    Uuid                       @map("team_id")
  team      Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName  String                     @map("full_name")
  groupName StudentGroup               @map("group_name")
  isLeader  Boolean                    @default(false) @map("is_leader")
  sortOrder SmallInt                   @default(0) @map("sort_order")
  createdAt temporal.createdAtString() @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  @@index([teamId])
  @@index([teamId], where: "is_leader", unique: true, name: "team_member_one_leader")
  @@check(expression: "char_length(full_name) <= 120", name: "team_member_full_name_length")
  @@map("team_member")
}

model Genre {
  id         Uuid                       @id @default(uuid())
  slug       String                     @unique
  name       String                     @unique
  createdAt  temporal.createdAtString() @map("created_at")
  games      Game[]
  gameGenres GameGenre[]

  @@check(expression: "slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND char_length(slug) <= 40", name: "genre_slug_format")
  @@check(expression: "char_length(name) <= 40", name: "genre_name_length")
  @@map("genre")
}

model Platform {
  id            Uuid                       @id @default(uuid())
  slug          String                     @unique
  name          String                     @unique
  createdAt     temporal.createdAtString() @map("created_at")
  gamePlatforms GamePlatform[]

  @@check(expression: "slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND char_length(slug) <= 40", name: "platform_slug_format")
  @@check(expression: "char_length(name) <= 40", name: "platform_name_length")
  @@map("platform")
}

model Game {
  id          Uuid                       @id @default(uuid())
  teamId      Uuid                       @unique @map("team_id")
  team        Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Género principal: el que agrupa el catálogo.
  genreId     Uuid                       @map("genre_id")
  genre       Genre                      @relation(fields: [genreId], references: [id])
  slug        String                     @unique
  name        String
  description String
  /// "Acerca del juego": párrafos separados por una línea en blanco. Sin valor, el sitio usa
  /// el texto genérico de `games-copy.ts`.
  about       String?
  /// Jugadores por partida en la demo.
  players     SmallInt                   @default(1)
  itchioUrl   String?                    @map("itchio_url")
  sortOrder   SmallInt                   @default(0) @map("sort_order")
  createdAt   temporal.createdAtString() @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")
  extraGenres GameGenre[]
  platforms   GamePlatform[]
  images      GameImage[]
  checkIns    CheckIn[]

  @@index([genreId])
  @@check(expression: "slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND char_length(slug) <= 80", name: "game_slug_format")
  @@check(expression: "char_length(name) <= 80", name: "game_name_length")
  @@check(expression: "char_length(description) <= 300", name: "game_description_length")
  @@check(expression: "char_length(about) <= 3000", name: "game_about_length")
  @@check(expression: "players BETWEEN 1 AND 16", name: "game_players_range")
  @@check(expression: "itchio_url ~ '^https://[a-z0-9-]+[.]itch[.]io/'", name: "game_itchio_url_format")
  @@map("game")
}

/// Géneros extra de un juego, además del principal.
model GameGenre {
  gameId  Uuid  @map("game_id")
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genreId Uuid  @map("genre_id")
  genre   Genre @relation(fields: [genreId], references: [id])

  @@id([gameId, genreId])
  @@index([genreId])
  @@map("game_genre")
}

model GamePlatform {
  gameId     Uuid     @map("game_id")
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platformId Uuid     @map("platform_id")
  platform   Platform @relation(fields: [platformId], references: [id])

  @@id([gameId, platformId])
  @@index([platformId])
  @@map("game_platform")
}

/// Fotos del juego: una portada (is_cover) y hasta 4 capturas.
model GameImage {
  id           Uuid                       @id @default(uuid())
  gameId       Uuid                       @map("game_id")
  game         Game                       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// URL https:// o ruta del sitio (/media/...).
  imageUrl     String                     @map("image_url")
  altText      String                     @map("alt_text")
  isCover      Boolean                    @default(false) @map("is_cover")
  /// Encuadre CSS (object-position), por ejemplo "60% 35%".
  cropPosition String?                    @map("crop_position")
  sortOrder    SmallInt                   @map("sort_order")
  createdAt    temporal.createdAtString() @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")

  @@unique([gameId, sortOrder])
  @@index([gameId], where: "is_cover", unique: true, name: "game_image_one_cover")
  @@check(expression: "image_url ~ '^(https://|/[^/])'", name: "game_image_url_format")
  @@check(expression: "char_length(alt_text) <= 160", name: "game_image_alt_text_length")
  @@check(expression: "char_length(crop_position) <= 20", name: "game_image_crop_position_length")
  @@check(expression: "sort_order BETWEEN 0 AND 4", name: "game_image_sort_order_range")
  @@map("game_image")
}

// ---------------------------------------------------------------------------
// Participación de visitantes: check-ins y sorteo
// ---------------------------------------------------------------------------

model Visitor {
  id           Uuid                       @id @default(uuid())
  /// En minúsculas: letras sin acento, números, "_", "." y "-".
  gamertag     String                     @unique
  /// SHA-256 (hex) del token del QR personal.
  qrTokenHash  String                     @unique @map("qr_token_hash")
  createdAt    temporal.createdAtString() @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")
  checkIns     CheckIn[]
  raffleTicket RaffleTicket?

  @@check(expression: "gamertag ~ '^[a-z0-9_.-]{3,24}$'", name: "visitor_gamertag_format")
  @@check(expression: "qr_token_hash ~ '^[0-9a-f]{64}$'", name: "visitor_qr_token_hash_hex")
  @@map("visitor")
}

/// "Probó este juego". El id lo genera el escáner del stand (reenvíos idempotentes).
model CheckIn {
  id        Uuid                       @id
  visitorId Uuid                       @map("visitor_id")
  visitor   Visitor                    @relation(fields: [visitorId], references: [id])
  gameId    Uuid                       @map("game_id")
  game      Game                       @relation(fields: [gameId], references: [id])
  /// Hora del escaneo, ajustada al horario del evento y nunca posterior a created_at.
  scannedAt TimestamptzString          @map("scanned_at")
  createdAt temporal.createdAtString() @map("created_at")

  @@unique([visitorId, gameId])
  @@index([gameId, scannedAt])
  @@check(expression: "scanned_at <= created_at", name: "check_in_scanned_before_received")
  @@map("check_in")
}

model RaffleTicket {
  /// Número del sorteo. Puede tener huecos: se sortea entre las filas que existen.
  ticketNumber Int                        @id @default(autoincrement()) @map("ticket_number")
  visitorId    Uuid                       @unique @map("visitor_id")
  visitor      Visitor                    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  /// Formato internacional, por ejemplo +529981234567.
  phone        String                     @unique
  wonAt        TimestamptzString?         @map("won_at")
  notifiedAt   TimestamptzString?         @map("notified_at")
  createdAt    temporal.createdAtString() @map("created_at")

  @@check(expression: "phone ~ '^[+][1-9][0-9]{7,14}$'", name: "raffle_ticket_phone_format")
  @@check(expression: "notified_at IS NULL OR won_at IS NOT NULL", name: "raffle_ticket_notified_winner")
  @@map("raffle_ticket")
}
