# Copia este archivo a `.env` y cambia los valores por los de tu base de datos.
# Requiere PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/ut_game_showcase"

# URL pública del sitio: absoluta http(s) y sin "/" final. Se usa en metadata, Open Graph,
# sitemap y robots. Obligatoria en producción: sin ella `npm run build` falla. En desarrollo
# y pruebas, si falta, se usa http://localhost:3000. Se valida en src/shared/lib/env.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
