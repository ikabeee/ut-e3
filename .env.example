.env.example# Copia este archivo a `.env` y cambia los valores si lo necesitas.
# Requiere PostgreSQL >= 15. El valor por defecto es la base de docker-compose.yml (PostgreSQL 16):
# levántala con `docker compose up -d --wait db` (ver docs/data-sources.md).
DATABASE_URL="postgresql://utg:utg@localhost:5432/ut_game_showcase"

# URL pública del sitio: absoluta http(s) y sin "/" final. Se usa en metadata, Open Graph,
# sitemap y robots. Obligatoria en producción: sin ella `npm run build` falla. En desarrollo
# y pruebas, si falta, se usa http://localhost:3000. Se valida en src/shared/lib/env.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Fuente de datos del servidor: "mock" (juegos del diseño, sin base de datos) o "prisma"
# (PostgreSQL de DATABASE_URL, con las migraciones y los seeds aplicados). Si falta se usa "mock".
# Se valida en src/shared/lib/env.ts (ver docs/data-sources.md).
DATA_SOURCE="mock"

# Usuario y contraseña (HTTP Basic) del panel de administración (/admin) y de sus acciones.
# Si falta alguna, el panel no abre y nadie puede crear, editar ni borrar datos.
ADMIN_USER=""
ADMIN_PASSWORD=""

# Dominios desde los que se aceptan fotos de juegos por URL https, separados por comas
# (por ejemplo "img.itch.zone"). Las rutas del sitio (/mock/...) siempre se aceptan.
# next/image los fija en el build: cambiarlos requiere volver a compilar.
IMAGE_REMOTE_HOSTS=""

# Opcional: credenciales y puertos de docker-compose.yml.
# POSTGRES_USER="utg"
# POSTGRES_PASSWORD="utg"
# POSTGRES_DB="ut_game_showcase"
# POSTGRES_PORT="5432"
# APP_PORT="3000"
