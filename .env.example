DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Cuenta del sysadmin que crea `npm run db:seed` (solo si aún no hay un sysadmin).
SYSADMIN_EMAIL="sysadmin@ejemplo.com"
SYSADMIN_NAME="Coordinación E3"
SYSADMIN_PASSWORD="cambia-esta-contraseña"

# Configuración de correo saliente (Nodemailer / SMTP)
# SMTP es opcional: sin SMTP_HOST los correos no salen y quedan en la tabla email_outbox de la base.
# Si defines SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD y SMTP_FROM son obligatorias: sin alguna,
# el servidor no arranca y el log dice cuál falta. El puerto 465 usa TLS directo; los demás, STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="\"UT Game Showcase\" <no-reply@showcase.ute3.edu.mx>"

# Contraseña de todas las cuentas de `npm run db:seed:demo` (solo desarrollo y demos; se niega en producción).
# DEMO_PASSWORD="cambia-esta-clave-de-demo"
