# Variables de produccion (docs/deploy.md). Copia este archivo a `.env` en el VPS y llena los valores; el `.env` no se
# versiona. Los valores de abajo son de ejemplo.

# --- Obligatorias ---------------------------------------------------------------------------------------------------

# URL publica de la app, sin "/" al final. Se incrusta al construir la imagen: si la cambias, reconstruye.
NEXT_PUBLIC_SITE_URL="https://showcase.ejemplo.com"

# Clave que cifra los PIN de los pasaportes (32 bytes en base64). Genera una con: openssl rand -base64 32
# Si la pierdes o la cambias, los PIN guardados dejan de poder leerse.
PIN_ENCRYPTION_KEY=""

# Cuenta del sysadmin que crea el primer arranque (solo si todavia no hay un sysadmin).
SYSADMIN_EMAIL="sysadmin@ejemplo.com"
SYSADMIN_NAME="Coordinacion E3"
SYSADMIN_PASSWORD=""

# --- Opcionales -----------------------------------------------------------------------------------------------------

# Puerto del equipo donde el proxy inverso encuentra la app (solo escucha en 127.0.0.1). Por defecto 3000.
APP_PORT=3000

# Etiqueta de la imagen que construye Compose. Por defecto "latest".
APP_TAG=latest

# Correo saliente. SMTP es opcional: sin SMTP_HOST los correos (invitaciones de cuenta) no salen y quedan en la tabla
# email_outbox de la base. Si defines SMTP_HOST, las otras cuatro son obligatorias.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
